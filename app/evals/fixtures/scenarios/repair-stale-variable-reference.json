            "expected": {
              "params.system_prompt": "eval-broken-variable-reference"
            }
          }
        ]
      },
      "goal_step_id": "repair"
    },
    {
      "type": "tool_call",
      "tool_name": "workflow.test_draft",
      "arguments": {
        "workspace_version": "${workspace_version}",
        "inputs": {"query": "Evaluate repaired reference."},
        "requested_test_runs": 1
      },
      "goal_step_id": "test"
    },
    {
      "type": "tool_call",
      "tool_name": "workflow.diff",
      "arguments": {"workspace_version": "${workspace_version}"},
      "goal_step_id": "review"
    },
    {
      "type": "finish",
      "summary": "The stale reference was repaired.",
      "evidence": ["The second approved candidate run succeeded."]
    }
  ]
