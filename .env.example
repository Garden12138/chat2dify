DIFY_SOURCE_DIR=../dify
DIFY_CONSOLE_API_BASE=http://127.0.0.1/console/api
DIFY_CONSOLE_WEB_BASE=http://127.0.0.1
# Leave empty for standalone mode. Set to /chat2dify when served inside the
# Dify nginx panel route from deploy/dify/docker-compose.chat2dify.yaml.
CHAT2DIFY_PUBLIC_BASE_PATH=

# v4 Builder Agent API. Disabled by default so all v3 paths remain effective.
CHAT2DIFY_AGENT_V4_ENABLED=false

# v5 AI Workflow Studio. It is disabled by default and does not replace v4
# until explicitly enabled. Generate a unique 32+ character signing secret.
CHAT2DIFY_AI_STUDIO_V5_ENABLED=false
CHAT2DIFY_STUDIO_SIGNING_SECRET=
# SQLite is used when omitted. Team deployments can use:
# postgresql://user:password@postgres:5432/chat2dify
CHAT2DIFY_STUDIO_DATABASE_URL=
CHAT2DIFY_STUDIO_ALLOWED_ORIGINS=http://127.0.0.1
CHAT2DIFY_STUDIO_TOKEN_TTL_SECONDS=900

# Required for POST /api/workflows/create against a real Dify instance.
DIFY_EMAIL=
DIFY_PASSWORD=
DIFY_LOGIN_LANGUAGE=en-US

# Used by the generated LLM nodes inside Dify.
DIFY_DEFAULT_MODEL_PROVIDER=langgenius/openai/openai
DIFY_DEFAULT_MODEL_NAME=gpt-4o-mini

# Comma-separated Dify dataset IDs used when generating knowledge-retrieval nodes.
DIFY_DEFAULT_DATASET_IDS=

# NVIDIA NIM is the default Planner. If the key is omitted, chat2dify falls
# back to the first configured provider in PLANNER_FALLBACK_PROVIDERS. If none
# are configured, create draft falls back to a deterministic simple workflow.
PLANNER_DEFAULT_PROVIDER=nvidia
PLANNER_FALLBACK_PROVIDERS=openrouter,openai-compatible,openai
PLANNER_TIMEOUT_SECONDS=600
PLANNER_REQUEST_RETRIES=2
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Supported: deepseek-ai/deepseek-v4-flash, deepseek-ai/deepseek-v4-pro
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_THINKING=false
NVIDIA_REASONING_EFFORT=low
NVIDIA_MAX_TOKENS=8192

# Optional OpenRouter Planner fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MAX_TOKENS=8192

# Optional generic OpenAI-compatible Planner entry for OneAPI/NewAPI/LiteLLM/self-hosted gateways.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:4000/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_LABEL=OpenAI-compatible
OPENAI_COMPATIBLE_MAX_TOKENS=8192
OPENAI_COMPATIBLE_RESPONSE_FORMAT=true

# Optional official OpenAI Planner fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Background Web UI workflow tasks.
CHAT2DIFY_TASK_DB=data/tasks.sqlite3
CHAT2DIFY_TASK_WORKERS=2
